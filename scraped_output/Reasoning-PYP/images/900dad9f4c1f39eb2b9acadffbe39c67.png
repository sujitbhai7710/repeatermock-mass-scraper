      <div id="counselRegisterNext" class="next">Submit</div>
    </form>

    <!-- Counselling - City -->

    <form id="counselCity">
      <div class="hd-input-group form-group counsel-date">
        <div class="dd-arrow">
        </div>
        <input type="date" class="form-control" id="counsel-date" name="date" required=""
          onchange="clearError('counsel-date')">
        <label for="counsel-date">Your preferred date<span>*</span></label>
        <span class="bar"></span>
        <div class="error-container" id="counsel-name-error">This is a mandatory field</div>
      </div>

      <div class="hd-input-group form-group">
        <div class="dd-arrow">
        </div>
        <select class="form-control" id="counsel-time" name="time" required onchange="clearError('counsel-time')">
          <option value="11:00 AM">11 AM</option>
          <option value="12:00 PM">12 PM</option>
          <option value="01:00 PM">1 PM</option>
          <option value="02:00 PM">2 PM</option>
          <option value="03:00 PM">3 PM</option>
          <option value="04:00 PM">4 PM</option>
          <option value="05:00 PM">5 PM</option>
          <option value="06:00 PM">6 PM</option>
          <option value="07:00 PM">7 PM</option>
          <option value="08:00 PM">8 PM</option>
          <option value="09:00 PM">9 PM</option>
          <option value="10:00 PM">10 PM</option>
          <option value="11:00 PM">11 PM</option>
        </select>
        <label for="counsel-time">Your preferred time<span>*</span></label>
        <span class="bar"></span>
        <div class="error-container" id="counsel-name-error">This is a mandatory field</div>
      </div>

      <div class="hd-input-group form-group">
        <textarea class="form-control" rows="1" id="counsel-address" name="fullAddress" required></textarea>
        <label for="counsel-address">Your full address</label>
        <span class="bar"></span>
        <div class="error-container" id="counsel-name-error">This is a mandatory field</div>

      </div>

      <div id="counselCitySubmit" class="next">SUBMIT</div>
    </form>

    <!-- Counselling - Success -->
    <div id="counselSuccess">
      <img src="/static/images/checked.svg" alt="" loading='lazy' />
      <h2>Your FREE Online counselling session has been booked!</h2>
      <p>
        Vedantu academic counsellor will be calling you shortly for your Online Counselling session.
      </p>
      <div id="counselSuccessDone" class="next">DONE</div>
    </div>

    <!-- Counselling - Loading -->
    <div id="counselLoader">
      <div class="loader"></div>
    </div>

    <!-- Counselling - Error -->
    <div id="counselError">
      <img src="/static/images/error-icon.svg" alt="" loading='lazy' />
      <h2>Please try again later</h2>
      <div id="counselErrorOk" class="next">OK</div>
    </div>
  </div>
</div>
<style>
  .counselling-register{display:none;position:fixed;z-index:99;left:0;top:0;width:100%;height:100%;overflow:auto;background-color:rgb(0,0,0);background-color:rgba(0,0,0,0.4);justify-content:center;align-items:center;}.counselling-register small{display:none;color:red;}.counselling-register .modal-content{position:relative;background-color:#ffffff;margin:2rem auto;border:1px solid #888;width:80%;box-shadow:0 4px 8px 0 rgba(0,0,0,0.2),0 6px 20px 0 rgba(0,0,0,0.19);-webkit-animation-name:animatetop;-webkit-animation-duration:0.4s;animation-name:animatetop;animation-duration:0.4s;overflow:visible;border-radius:5px;text-align:center;min-height:150px;}@-webkit-keyframes animatetop{from{top:-300px;opacity:0;}to{top:0;opacity:1;}}@keyframes animatetop{from{top:-300px;opacity:0;}to{top:0;opacity:1;}}.counselling-register .close{position:absolute;top:-15px;right:-14px;border-radius:50%;background-color:#cccccc;width:30px;height:30px;display:inline-flex;justify-content:center;align-items:center;font-size:26px;font-family:"Open Sans",sans-serif !important;opacity:1;}.counselling-register .close:hover,.counselling-register .close:focus{color:#000;text-decoration:none;cursor:pointer;}.counselling-register .modal-header{text-align:left;padding-bottom:0.75rem;}.counselling-register .modal-header h2{font-family:Raleway;font-size:17px;font-weight:bold;text-align:center;color:#333333;margin:0px;}.counselling-register .modal-header p{margin:0px;margin-top:8px;color:#000000;font-family:Raleway;font-size:14px;font-weight:500;opacity:0.6;}.counselling-register .next{width:180px;height:56px;border-radius:28px;padding:18px;background-color:#ff6200;color:#fff;text-transform:uppercase;font-weight:bold;border:0;cursor:pointer;font-size:16px;line-height:1.25;color:#ffffff;display:inline-block;font-family:Raleway;}.counselling-register input:focus,.counselling-register select:focus{outline:none;}.counselling-register .hd-input-group label span{color:red;font-size:14px;font-family:"Open Sans",sans-serif !important;margin-left:3px;}.counselling-register .error small{display:block;}.counselling-register .error input{border:1px solid red;}.counselling-register .error select,.counselling-register .error textarea{border:1px solid red;}.counselling-register .form-control{display:block;width:100%;height:34px;padding:6px 12px;font-size:14px;line-height:1.42857143;color:#555;background-color:#fff;background-image:none;border:1px solid #ccc;border-radius:4px;font-family:"Open Sans",sans-serif;-webkit-box-shadow:inset 0 1px 1px rgba(0,0,0,0.075);box-shadow:inset 0 1px 1px rgba(0,0,0,0.075);-webkit-transition:border-color ease-in-out 0.15s,box-shadow ease-in-out 0.15s;-webkit-transition:border-color ease-in-out 0.15s,-webkit-box-shadow ease-in-out 0.15s;transition:border-color ease-in-out 0.15s,-webkit-box-shadow ease-in-out 0.15s;transition:border-color ease-in-out 0.15s,box-shadow ease-in-out 0.15s;transition:border-color ease-in-out 0.15s,box-shadow ease-in-out 0.15s,-webkit-box-shadow ease-in-out 0.15s;}#counsel-header{align-items:center;text-align:center;margin-bottom:32px;}#counsel-header img{display:none;margin-right:1rem;cursor:pointer;}#counselSelectedCity.show{display:inline;}#counsel-address.form-control{overflow:hidden;}.counselling-register,#counselSelectedCity{display:none;}#counselSuccess,#counselError{font-family:"Open Sans",sans-serif;}#counselSuccess{margin-top:20px;margin-bottom:20px;}#counselSuccess h2{font-size:24px;font-weight:bold;font-stretch:normal;font-style:normal;line-height:1.5;letter-spacing:normal;text-align:center;font-family:Raleway;}#counselSuccess p{font-size:14px;font-weight:normal;font-stretch:normal;font-style:normal;line-height:1.43;letter-spacing:normal;text-align:center;color:#222222;font-family:Raleway;}#counselSuccess img,#counselError img{height:100px;}#counselError h2{font-size:18px;font-weight:bold;font-stretch:normal;font-style:normal;line-height:1.5;letter-spacing:normal;text-align:center;color:#e2564b;}#counselRegister,#counselCity{transition:all ease-in-out 0.15s;}#counsel-time{font-family:"Open Sans",sans-serif;}.is-modalOpen{overflow:hidden;}.is-modalOpen .counselling-register{display:flex;}.counselling-register.is-registerSuccess #counselSuccess{display:block;}.counselling-register.is-register #counselCity,.counselling-register.is-register #counselError,.counselling-register.is-citySelected #counselRegister,.counselling-register.is-citySelected #counselSuccess,.counselling-register.is-citySelected #counselError,.counselling-register.is-registerSuccess #counselRegister,.counselling-register.is-registerSuccess #counselCity,.counselling-register.is-registerSuccess #counselError,.counselling-register.is-registerSuccess #counsel-header,.counselling-register.is-registerSuccess #counsel-close,.counselling-register.is-registerError #counselRegister,.counselling-register.is-registerError #counselCity,.counselling-register.is-registerError #counselSuccess,.counselling-register.is-registerError #counsel-header,.counselling-register.is-registerError #counsel-close,.counselling-register.is-loader #counselRegister,.counselling-register.is-loader #counselCity,.counselling-register.is-loader #counselSuccess,.counselling-register.is-loader #counselError,.counselling-register.is-loader #counsel-header,.counselling-register.is-loader #counsel-close{display:none;}.counselling-register.is-loader #counselLoader{display:block;height:fit-content;width:fit-content;}.counselling-register.is-citySelected #counsel-header img{display:unset;float:left;}.counselling-register.is-registerSuccess .modal-header,.counselling-register.is-registerError .modal-header,.counselling-register.is-loader .modal-header{border:0;}#counselErrorOk{margin-top:2rem;}#book-now-button{cursor:pointer;}#counselLoader{display:none;}#counselSuccess{display:none;}.show{display:block;}.counselling-register .loader{position:absolute;left:50%;top:60%;z-index:1;width:150px;height:150px;margin:-75px 0 0 -65px;border:16px solid #f3f3f3;bord
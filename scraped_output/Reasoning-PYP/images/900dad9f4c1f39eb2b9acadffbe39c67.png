    <script>
        (function (window, document) {
            var getCookieValue = function (name) {
                /**
                 * @description- To get the cookie value.
                 * @returns {string | null}- returns the cookie value if present or returns null.
                 */
                var value = "; " + document.cookie;
                var parts = value.split("; " + name + "=");
                if (parts.length == 2) return parts.pop().split(";").shift();
                return null;
            };

            var useAppDOM = document.getElementById("use-app");
            if (!!useAppDOM) {
                var ABValue = getCookieValue('USE_APP_AB');
                var isMasterClassPage = (window.location.pathname == '/masterclass') || (window.location.pathname == '/masterclass/') ;
                if (!!ABValue && (ABValue == "VARIANT1" || isMasterClassPage)) {
                    useAppDOM.setAttribute("data-type", "VARIANT1");
                } else if (!!ABValue && ABValue == "VARIANT2") {
                    useAppDOM.innerHTML = "Learn LIVE";
                    useAppDOM.setAttribute("data-type", "VARIANT2");
                } else if (!ABValue) {
                    var ABRandomValue = (Math.random().toFixed(2) * 100);
                    if (ABRandomValue < 50 || isMasterClassPage) {
                        useAppDOM.setAttribute("data-type", "VARIANT1");
                        document.cookie = "USE_APP_AB=VARIANT1;expires=" + new Date(new Date().getTime() + 31556952000).toGMTString() + "path=/;domain=.vedantu.com";
                    } else {
                        useAppDOM.innerHTML = "Learn LIVE";
                        useAppDOM.setAttribute("data-type", "VARIANT2");
                        document.cookie = "USE_APP_AB=VARIANT2;expires=" + new Date(new Date().getTime() + 31556952000).toGMTString() + "path=/;domain=.vedantu.com";
                    }
                }
            }
        })(window, window.document);

        function handleWebUseAppClick() {
            !!window.clickStream && window.clickStream.pushEvent("Header", "Button_Click", "Free_Classes_Clicked", null, null);
            setTimeout(function() {
                window.location.href = "/masterclass?utm_source=seo&utm_medium=header_bt&utm_campaign=header_mc_bt&utm_content=header_mc_bt_freeclass";
            });
        }

        function handleUseAppClick() {
            var useAppDOM = document.getElementById("use-app");
            if (!!useAppDOM) {
                var eventParams = {
                    'key1': 'CTA_Label',
                    'value1': '',
                    'key2': 'pageurl',
                    'value2': window.location.href
                }
                if (useAppDOM.dataset.type == "VARIANT1") {
                    eventParams.value1 = 'Use_App';
                    !!window.clickStream && window.clickStream.pushEvent("Header", "Button_Click", "Use_App_Clicked", null, eventParams);
                    setTimeout(function () {
                        window.location.href = "https://vedantu.app.link/mcGZ2nwpMV";
                    });
                } else if (useAppDOM.dataset.type == "VARIANT2") {
                    eventParams.value1 = 'Learn_Live';
                    !!window.clickStream && window.clickStream.pushEvent("Header", "Button_Click", "Learn_Live_Clicked", null, eventParams);
                    setTimeout(function () {
                        window.location.href = "/masterclass?utm_source=seo&utm_medium=header_bt&utm_campaign=header_mc_bt&utm_content=header_mc_bt_liveclass";
                    });
                } else {
                    setTimeout(function () {
                        window.location.href = "https://vedantu.app.link/mcGZ2nwpMV";
                    });
                }
            }
        }
    </script>
    <script>var loggedIn = false;</script>

    <script>
            (function (window, document) {
            function elementLoad(element, type) {
                var windowBottom = window.innerHeight;
                var elementBottom = element.getBoundingClientRect().top;
                if (elementBottom < windowBottom) {
                    if (!!config) {
                        var imageSource = element.dataset.src || element.dataset.bgsrc;
                        if (type == "img") {
                            if (lazyImage.dataset.src.startsWith("https://static.vedantu.com")) {
                                element.src = imageSource + "?ver=" + config.static.version;
                            } else {
                                element.src = imageSource;
                            }
                        } else {
                            if (lazyImage.dataset.src.startsWith("https://static.vedantu.com")) {
                                element.style.backgroundImage = "url('" + imageSource + '?ver=' + config.static.version + "')";
                            } else {
                                element.style.backgroundImage = "url('" + imageSource + "')";
                            }
                            element.removeAttribute('data-bgsrc');
                        }
                    }
                }
            }

            var lazyLoadScrollFun = function () {
                var pageImageList = document.querySelectorAll('img[data-src]');
                var backgroundImageList = document.querySelectorAll('div[data-bgsrc]');
                !!pageImageList && pageImageList.length > 0 && [].forEach.call(pageImageList, function (element) {
                    elementLoad(element, "img");
                    element.onload = function () {
                        element.removeAttribute('data-src');
                    }
                });
                !!backgroundImageList && backgroundImageList.length > 0 && [].forEach.call(backgroundImageList, function (element) {
                    elementLoad(element, "bg-img");
                });
            }

            function lazyload() {
                lazyLoadScrollFun();
            window.removeEventListener('scroll', lazyLoadScrollFun, true);
            window.addEventListener('scroll', lazyLoadScrollFun, true);
        };

        document.addEventListener("DOMContentLoaded", function () {
            var masterclassFreeLogo = document.querySelector("#masterclass-free-logo");
            if (!!masterclassFreeLogo) {
                masterclassFreeLogo.src = masterclassFreeLogo.dataset.src + "?ver=" + config.static.version;
                masterclassFreeLogo.removeAttribute('data-src');
            }
            var pageImageList = document.querySelectorAll('img[data-src]');
            var backgroundImageList = document.querySelectorAll('div[data-bgsrc]');

            if ("IntersectionObserver" in window) {

                var lazyImageObserver = new IntersectionObserver(function (entries, observer) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            var lazyImage = entry.target;
                            if (lazyImage.hasAttribute('data-src')) {
                                if (lazyImage.dataset.src.startsWith("https://static.vedantu.com")) {
                                    lazyImage.src = lazyImage.dataset.src + "?ver=" + config.static.version;
                                } else {
                                    lazyImage.src = lazyImage.dataset.src;
                                }
                                lazyImage.removeAttribute('data-src');
                                lazyImageObserver.unobserve(lazyImage);

                            } else if (lazyImage.hasAttribute('data-bgsrc')){
                                if (lazyImage.dataset.bgsrc.startsWith("https://static.vedantu.com")) {
                                    lazyImage.style.backgroundImage = "url('" + lazyImage.dataset.bgsrc + "')";
                                } else {
                                    lazyImage.style.backgroundImage = "url('" + lazyImage.dataset.bgsrc + '?ver=' + config.static.version + "')";
                                }
                                lazyImage.removeAttribute('data-bgsrc');
                                lazyImageObserver.unobserve(lazyImage);
                            }
                        }
                    });
                });

                pageImageList.forEach(function (lazyImage) {
                    !!lazyImage && lazyImageObserver.unobserve(lazyImage);
                    !!lazyImage && lazyImageObserver.observe(lazyImage);
                });

                backgroundImageList.forEach(function (lazyImage) {
                    !!lazyImage && lazyImageObserver.unobserve(lazyImage);
                    !!lazyImage && lazyImageObserver.observe(lazyImage);
                });
            } else {
                lazyload();
            }
        });


        })(window, document);
    </script>

     
        <style>
  .counselling-register,.show-lists {
    display: none;
  }
  .hide-list{
    display: none;
  }
  .date-picker{
    width: 100%;
    height: 50px;
    border: none;
    border-bottom: 1px solid #CCC;
    margin-bottom: 25px;
    cursor: pointer;
  }
  input[type="time"]::-webkit-calendar-picker-indicator {
    color: rgba(0, 0, 0, 0);
    opacity: 1;
    display: block;
    width: 20px;
    height: 20px;
    border-width: thin;
}
.time-picker{
  position: relative;
}
.selectTime{
  cursor: auto;
}

.time-error,.date-error{
  display: none;
}
.show-list{
  position: absolute;
  background-color: #FFF;
  bottom: 10px;
  right: 0;
  border: 1px solid #cccccc73;
  border-radius: 5px;
}
.show-list ul{
  list-style: none;
  padding: 0px 20px;
  max-height:200px;
  overflow-y: scroll;
}
.show-list ul li{
  margin-bottom: 10px;
  cursor: pointer;
}
.counselling-register .hd-input-group {
    margin-bottom: 35px;
}
.basicDate{
  background-color: #FFF;
  cursor: auto !important;
}
</style>

<div id="counselling-register" class="modal is-register counselling-register">
  <div class="modal-content">
    <div class="modal-header">
      <div id="counsel-header">
        <img id="counselBack" src="/static/images/back.svg" alt="" loading='lazy' height="25px" />
        <div>
          <h2>Book your FREE Online counselling session</h2>
          <p> Share the following information</p>
        </div>
      </div>
      <span id="counsel-close" class="close">&times;</span>
    </div>

    <!-- Counselling - Register -->

    <form id="counselRegister">
      <div class="hd-input-group form-group">
        <input required="" id="counsel-name" type="text" class="form-control" name="fullName"
          onkeydown="clearError('counsel-name')">
        <label for="counsel-name">Your Name<span>*</span> </label>
        <span class="bar"></span>
        <div class="error-container" id="counsel-name-error">Please enter your Name</div>
      </div>

      <div class="hd-input-group form-group">
        <input type="tel" class="form-control" id="counsel-number" name="contactNumber" maxlength="10" required=""
          onkeydown="clearError('counsel-number')" />
        <label for="counsel-number">Contact Number (India only)<span>*</span></label>
        <span class="bar"></span>
        <div class="error-container" id="counsel-number-error"></div>
      </div>

      <div class="hd-input-group form-group counsel-grade">
        <div class="dd-arrow">
        </div>
        <select class="form-control" id="counsel-grade" name="grade" required="" onchange="clearError('counsel-grade')">
          <option value="LKG">LKG</option>
          <option value="UKG">UKG</option>
          <option value="Class 1">Class 1</option>
          <option value="Class 2">Class 2</option>
          <option value="Class 3">Class 3</option>
          <option value="Class 4">Class 4</option>
          <option value="Class 5">Class 5</option>
          <option value="Class 6">Class 6</option>
          <option value="Class 7">Class 7</option>
          <option value="Class 8">Class 8</option>
          <option value="Class 9">Class 9</option>
          <option value="Class 10">Class 10</option>
          <option value="Class 8-10 JEE NEET Foundation">Class 8-10 JEE NEET Foundation</option>
          <option value="Class 11-CBSE-Commerce">Class 11-CBSE-Commerce</option>
          <option value="Class 11-CBSE-Science">Class 11-CBSE-Science</option>
          <option value="Class 11-NEET">Class 11-NEET</option>
          <option value="Class 11-JEE">Class 11-JEE</option>
          <option value="Class 11-Computer Science">Class 11-Computer Science</option>
          <option value="Class 11-MH-Board-Commerce">Class 11-MH-Board-Commerce</option>
          <option value="Class 12-CBSE-Commerce">Class 12-CBSE-Commerce</option>

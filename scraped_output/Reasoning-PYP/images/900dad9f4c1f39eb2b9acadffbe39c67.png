<script>
  let isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
  if (!isSafari) {
    document.getElementById('counsel-date').min = new Date().toISOString().split("T")[0];
  }
</script>

<script>
  function clearError(id) {
    let currentInput = document.getElementById(id);
    if (currentInput) {
      currentInput.parentElement.classList.remove('error');
    }
  }


</script>


racking.id=MAXXXWVX&amp;utm_content=acq&amp;utm_medium=website_hero&amp;utm_source=ngs&amp;en_txn6=MAXXXWVX&amp;en_txn7=YXXXXXX3" data-test-id="hero-header-button-cta" class="align-items-center gap-2 text-uppercase mt-2 btn btn-primary">Support Us Today</a></div></div></div></header><div></div><section><div class="missionMoment_missionMomentContainer__qg906"><img class="d-block d-md-none z-0 w-100 h-100 object-fit-cover position-absolute top-0 left-0" src="https://images.nationalgeographic.org/image/upload/t_ngsmainsite_mission_moment-mobile/NGS%20Main%20Site/Home/2021-10-Jane_Image"/><img class="d-none d-md-block d-lg-none z-0 w-100 h-100 object-fit-cover position-absolute top-0 left-0" src="https://images.nationalgeographic.org/image/upload/t_ngsmainsite_mission_moment/NGS%20Main%20Site/Home/2021-10-Jane_Image"/><img class="d-none d-lg-block z-0 w-100 h-100 object-fit-cover position-absolute top-0 left-0" src="https://images.nationalgeographic.org/image/upload/t_ngsmainsite_mission_moment-xl/NGS%20Main%20Site/Home/2021-10-Jane_Image"/><div class="overlay--black-20 w-100 z-1"></div><div class="tooltip-asset-info-container bottom-0 end-0"><div style="z-index:40" class="position-absolute bg-secondary d-flex p-2 bottom-0 end-0" data-test-id="tooltip-asset-tooltip"><svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" viewBox="0 0 20 20" fill="none" class="bg-secondary m-auto" color="white" data-test-id="ng-icon"><g clip-path="url(#clip0_0_1019)"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 10C0 15.5228 4.47715 20 10 20C15.5228 20 20 15.5228 20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10ZM18.8235 10C18.8235 14.8731 14.8731 18.8235 10 18.8235C5.1269 18.8235 1.17647 14.8731 1.17647 10C1.17647 5.1269 5.1269 1.17647 10 1.17647C14.8731 1.17647 18.8235 5.1269 18.8235 10ZM11.1451 5.6549C11.1473 5.95576 11.0277 6.2447 10.8134 6.45597C10.5992 6.66723 10.3086 6.78284 10.0078 6.77647C9.38842 6.77647 8.88627 6.27433 8.88627 5.6549C8.88627 5.03548 9.38842 4.53333 10.0078 4.53333C10.3086 4.52697 10.5992 4.64257 10.8134 4.85384C11.0277 5.0651 11.1473 5.35404 11.1451 5.6549ZM10.9804 15.5059V7.95294H9.03529V15.5059H10.9804Z" fill="currentColor"></path></g><defs><clipPath id="clip0_0_1019"><rect width="20" height="20" fill="white"></rect></clipPath></defs></svg></div></div><div class="missionMoment_missionMoment__8fO64" data-test-id="mission-moment"><div class="missionMoment_missionContent__C2EWJ"><h2 class="missionMoment_missionTitle__gIFq1" data-test-id="mission-title">We Empower People to Make a Difference</h2><div class="missionMoment_divider__j9gIH"></div><p class="missionMoment_missionDescription__ApA1Z" data-test-id="mission-description">Using the power of science, exploration, education and storytelling to illuminate and protect the wonder of our world.</p></div><div class="missionMoment_areasOfWorkContainerDesktop__ImkWh"><div class="missionMoment_areasOfWorkLabel__z_ySS missionMoment_itemPaddings__UN7vI display-4">Our Approach</div><div class="missionMoment_areasOfWorkListDesktop__G20Av" data-test-id="areas-of-work-list-desktop"><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7" data-test-id="area-of-work-item-0"><a class="missionMoment_areaTitle__gF0U2" href="/explore/explorers" data-test-id="area-of-work-link-0">Explorers</a><div class="missionMoment_areaSubtitle__PHbU_" data-test-id="area-of-work-subtitle-0">Meet our global community of Explorers who investigate, test hypotheses, innovate, stretch their creativity and push the boundaries of traditional thinking.</div></div><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7" data-test-id="area-of-work-item-1"><a class="missionMoment_areaTitle__gF0U2" href="/explore/programs" data-test-id="area-of-work-link-1">Programs</a><div class="missionMoment_areaSubtitle__PHbU_" data-test-id="area-of-work-subtitle-1">Get inspiration from our portfolio of Explorer-led programs that are creating outsized impact for nature, wildlife and historical places.</div></div><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7" data-test-id="area-of-work-item-2"><a class="missionMoment_areaTitle__gF0U2" href="https://education.nationalgeographic.org/" data-test-id="area-of-work-link-2">Education</a><div class="missionMoment_areaSubtitle__PHbU_" data-test-id="area-of-work-subtitle-2">Discover resources that inspire educators, youth and future Explorers to help learn about, care for and protect our world.</div></div></div></div></div></div><div class="missionMoment_areasOfWorkContainerMobile__VT9hM" data-test-id="areas-of-work-container-mobile"><div><div class="missionMoment_areasOfWorkLabel__z_ySS missionMoment_itemPaddings__UN7vI display-4 pb-0">Our Approach</div><div class="d-flex flex-column gap-3"><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7"><a class="missionMoment_areaTitle__gF0U2" href="/explore/explorers">Explorers</a><div class="missionMoment_areaSubtitle__PHbU_">Meet our global community of Explorers who investigate, test hypotheses, innovate, stretch their creativity and push the boundaries of traditional thinking.</div></div><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7"><a class="missionMoment_areaTitle__gF0U2" href="/explore/programs">Programs</a><div class="missionMoment_areaSubtitle__PHbU_">Get inspiration from our portfolio of Explorer-led programs that are creating outsized impact for nature, wildlife and historical places.</div></div><div class="missionMoment_itemPaddings__UN7vI missionMoment_areaItem__Fr5j7"><a class="missionMoment_areaTitle__gF0U2" href="https://education.nationalgeographic.org/">Education</a><div class="missionMoment_areaSubtitle__PHbU_">Discover resources that inspire educators, youth and future Explorers to help learn about, care for and protect our world.</div></div></div></div></div></section><section><div class="dataBlock_data-block-container__Wj6J8 w-100 py-5 px-lg-5 px-xl-4" style="background-image:linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url(https://images.nationalgeographic.org/image/upload/t_ngsmainsite_bg_image/NGS%20Main%20Site/Space/2024-05-cr-NASA-Tarantula-Nebula-NationalGeographic_1438662);background-size:cover;background-position:center;background-repeat:no-repeat" data-test-id="data-block"><div data-test-id="container" class="g-0 px-0 d-flex justify-content-center container"><div data-test-id="row" class="g-0 d-flex justify-content-center mx-lg-5 mx-xl-0 column-gap-3 column-gap-md-5 column-gap-xl-3 row"><div data-test-id="data-item-block" class="d-flex flex-column justify-content-start text-center px-3 dataBlockItem_data-block-item__m9kFr text-light fw-medium col-xl-3 col-lg-3 col-md-6 col-12"><div data-test-id="data-number" class="display-2 decorator-divider fw-medium" style="letter-spacing:6px">450+</div><p data-test-id="data-attribute" class="text-small pt-3 mb-0 no-limit-paragraphs">active Explorer-led conservation projects across our six focus areas</p></div><div data-test-id="data-item-block" class="d-flex flex-column justify-content-start text-center px-3 dataBlockItem_data-block-item__m9kFr text-light fw-medium col-xl-3 col-lg-3 col-md-6 col-12"><div data-test-id="data-number" class="display-2 decorator-divider fw-medium" style="letter-spacing:6px">140</div><p data-test-id="data-attribute" class="text-small pt-3 mb-0 no-limit-paragraphs">countries and areas with active efforts led by Explorers</p></div><div data-test-id="data-item-block" class="d-flex flex-column justify-content-start text-center px-3 dataBlockItem_data-block-item__m9kFr text-light fw-medium col-xl-3 col-lg-3 col-md-6 col-12"><div data-test-id="data-number" class="display-2 decorator-divider fw-medium" style="letter-spacing:6px">100%</div><p data-test-id="data-attribute" class="text-small pt-3 mb-0 no-limit-paragraphs">of your donation that directly funds mission-driven Explorer work</p></div></div></div></div></section><section><div class="w-100 topicSwitcherBlock_topic-switcher-block__lpoXN topicSwitcherBlock_theme-primary__tYd2s" data-test-id="topic-switcher-block"><div class="topicSwitcherBlock_block-layout__D4_tu topicSwitcherBlock_layout-primary__7rwWt"><div class="topicSwitcherBlock_header-section__4Xe8s"><p class="topicSwitcherBlock_block-label__pEt7R display-4 fw-medium topicSwitcherBlock_mb-2rem__EWUGx" data-test-id="topic-switcher-label">Our Focus</p><h2 class="topicSwitcherBlock_block-title__N5JSs fw-medium" data-test-id="topic-switcher-title">Maximizing Impact in Six Key Areas</h2></div><div class="topicSwitcherBlock_image-section__z09xv" data-test-id="topic-switcher-image"><img src="https://images.nationalgeographic.org/image/upload/t_ngsmainsite_topic_switcher/NGS%20Main%20Site/Home/14_cr_Thomas_P_Peschak_NationalGeographic_2740130_O3D" alt="Green sea turtles congregate near a dock in the Bahamas." class="topicSwitcherBlock_topic-image__nH5op d-block d-xl-none"/><img src="https://images.nationalgeographic.org/image/upload/t_ngsmainsite_topic_switcher_portrait/NGS%20Main%20Site/Home/14_cr_Thomas_P_Peschak_NationalGeographic_2740130_O3D" alt="Green sea turtles congregate near a dock in the Bahamas." class="topicSwitcherBlock_topic-image__nH5op d-none d-xl-block"/><div class="tooltip-asset-info-container topicSwitcherBlock_info-tooltip__JJp4l"><div style="z-index:40" class="position-absolute bg-secondary d-flex p-2 topicSwitcherBlock_info-tooltip__JJp4l" data-test-id="tooltip-asset-tooltip"><svg xmlns="http://www.w3.org/2000/svg" width="1rem" height="1rem" viewBox="0 0 20 20" fill="none" class="bg-secondary m-auto" color="white" data-test-id="ng-icon"><g clip-path="url(#clip0_0_1019)"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 10C0 15.5228 4.47715 20 10 20C15.5228 20 20 15.5228 20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10ZM18.8235 10C18.8235 14.8731 14.8731 18.8235 10 18.8235C5.1269 18.8235 1.17647 14.8731 1.17647 10C1.17647 5.1269 5.1269 1.17647 10 1.17647C
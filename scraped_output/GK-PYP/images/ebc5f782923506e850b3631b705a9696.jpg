":null}},{\"_id\":\"a89d6ac1-d76b-4371-b459-7e98f8fdc771\",\"_type\":\"ngsmain-topic\",\"anchorId\":null,\"ctaLink\":{\"_type\":\"ngsmain-ctaLink\",\"linkTarget\":true,\"text\":\"Learn More\",\"url\":\"/explore/focus/planetary-health\"},\"label\":\"Planetary Health\",\"media\":{\"_id\":null,\"_type\":\"ngsmain-cloudinaryImage\",\"alt\":\"Pneumatophores, aerial roots of mangroves, emerge to ensure survival in coastal challenges, providing gas exchange, stability and salt balance — a testament to resilience in the face of changing tides and harsh environments.\",\"anchorId\":null,\"asset\":{\"_key\":\"cymHFoT6TPXd76UoHELbL\",\"_type\":\"cloudinary.asset\",\"_version\":1,\"access_control\":[],\"access_mode\":\"public\",\"bytes\":1789427,\"context\":{\"custom\":{\"alt\":\"Pneumatophores, aerial roots of mangroves, emerge to ensure survival in coastal challenges,\\nproviding gas exchange, stability,and salt balance. A testament to resilience in the face of\\nchanging tides and harsh environments.\",\"caption\":\"Pneumatophores, aerial roots of mangroves, emerge to ensure survival in coastal challenges,\\nproviding gas exchange, stability,and salt balance. A testament to resilience in the face of\\nchanging tides and harsh environments.\"}},\"created_at\":\"2026-05-01T19:48:18Z\",\"created_by\":{\"id\":\"fcf45803a4ef12e6d96a234cd1a15d\",\"type\":\"user\"},\"folder\":\"NGS Main Site/Home\",\"folder_id\":\"cb0a7a8cad060d49e7e29e383442cf43f6\",\"format\":\"jpg\",\"height\":2250,\"id\":\"bba03c653866c2069b6ec89cbcbc8702\",\"metadata\":{\"credits\":\"Vidhyaa Chandramohan\",\"short_description\":\"Pneumatophores, aerial roots of mangroves, emerge to ensure survival in coastal challenges, providing gas exchange, stability,and salt balance. A testament to resilience in the face of changing tides and harsh environments.\"},\"public_id\":\"NGS Main Site/Home/47_NS117051716_EC-97659S-23_UAE_MANGROVES_VC_1058_cr_Vidhyaa_Chandramohan\",\"resource_type\":\"image\",\"secure_url\":\"http
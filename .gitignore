# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local test outputs (but allow scraped_output/ from GitHub Action)
test_output/
my_tests/
download/

# Playwright
playwright-report/
test-results/

# Temp files
*.tmp
*.bak
~$*

# Skip per-job index.json/index.html — too large to commit
# Generated by generate_index.py — only the merged top-level version is committed by the merge job
scraped_output/*/index.json
scraped_output/*/index.html
# Per-job database dirs — replaced by merge job's top-level scraped_output/database/
scraped_output/*/database/
